    {
      "id": "K1",
      "file": "kelly/K1_state_dependent_stake_positive.pp",
      "name": "财富相关下注额：负优势",
      "mode": "positive",
      "eta": "wealth",
      "k": "1",
      "a_or_b": "1/2",
      "a": "1/2",
      "eta0": "1",
      "prefactor": "2",
      "q_certified": "79/80",
      "c": "79/80",
      "initial": {
        "wealth": "1"
      },
      "guard": "1/2 <= wealth < 2",
      "invariant": "15/32 <= wealth <= 5/2",
      "tail": "min(1, 2*(79/80)^n)",
      "eta_degree": 1,
      "max_moment_constraint_degree": 2,
      "branches": [
        {
          "probability": "2/5",
          "update": {
            "wealth": "wealth+wealth^2/8"
          }
        },
        {
          "probability": "3/5",
          "update": {
            "wealth": "wealth-wealth^2/8"
          }
        }
      ],
      "proof_witnesses": [
        "c*wealth-E[wealth']=wealth*(wealth-1/2)/40 >= 0",
        "wealth' in [15/32,5/2] on closed guard [1/2,2]"
      ],
      "validation": "Exact rational polynomial proof witnesses; no external SOS synthesis run.",
      "source_sha256": "e50868a565851eb946127bd71101d7f5ccd9da7eff4b67cc3197d7b122dd878b",
      "eta_expression": "wealth",
      "family": "kelly"
    },
