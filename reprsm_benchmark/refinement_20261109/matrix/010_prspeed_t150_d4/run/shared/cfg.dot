digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: 0 <= 100 * x and 100 * x <= 50 and 0 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_assert_1" [shape=box, label="L_assert_1\\nassert\\nI: 0 <= 100 * x and 100 * x <= 50 and 0 <= 100 * y and 100 * y <= 50 and 1 <= 100 * t and 100 * t <= 151"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: 0 <= 100 * x and 100 * x <= 50 and 0 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= 100 * x and 100 * x <= 47 and 0 <= 100 * y and 100 * y <= 49 and 0 <= 100 * t and 100 * t <= 150"];
  "L_skip_1" [shape=box, label="L_skip_1\\nskip\\nI: 0 <= 100 * x and 100 * x <= 47 and 0 <= 100 * y and 100 * y <= 49 and 0 <= 100 * t and 100 * t <= 150"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= 100 * x and 100 * x <= 47 and 0 <= 100 * y and 100 * y <= 49 and 0 <= 100 * t and 100 * t <= 150"];
  "L_skip_2" [shape=box, label="L_skip_2\\nskip\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_probabilistic_2" [shape=box, label="L_probabilistic_2\\nprobabilistic\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_probabilistic_3" [shape=box, label="L_probabilistic_3\\nprobabilistic\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_probabilistic_4" [shape=box, label="L_probabilistic_4\\nprobabilistic\\nI: 0 <= 100 * x and 100 * x <= 47 and 49 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_branch_1" [shape=box, label="L_branch_1\\nbranch\\nI: 0 <= 100 * x and 100 * x <= 47 and 0 <= 100 * y and 100 * y <= 50 and 0 <= 100 * t and 100 * t <= 150"];
  "L_assign_6" [shape=box, label="L_assign_6\\nassign\\nI: 100 * x = 0 and 100 * y = 0"];
  "L_assign_7" [shape=box, label="L_assign_7\\nassign\\nI: 100 * x = 0"];
  "L_assign_8" [shape=box, label="L_assign_8\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_8";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_assert_1" -> "L_while_1" [label="T_1.1\\ng: 100 * t <= 150\\np: 1\\nid"];
  "L_assert_1" -> "l_f" [label="T_2.1\\ng: not 100 * t <= 150\\np: 1\\nid"];
  "L_assign_1" -> "L_assert_1" [label="T_3.1\\ng: true\\np: 1\\nt:=0.01 + t"];
  "L_assign_2" -> "L_assign_1" [label="T_4.1\\ng: true\\np: 1\\ny:=0.01 + y"];
  "L_skip_1" -> "L_assign_1" [label="T_5.1\\ng: true\\np: 1\\nid"];
  "L_probabilistic_1" -> "L_assign_2" [label="T_6.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_1" -> "L_skip_1" [label="T_6.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_skip_2" -> "L_assign_1" [label="T_7.1\\ng: true\\np: 1\\nid"];
  "L_assign_3" -> "L_assign_1" [label="T_8.1\\ng: true\\np: 1\\nx:=0.01 + x"];
  "L_probabilistic_2" -> "L_skip_2" [label="T_9.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_2" -> "L_assign_3" [label="T_9.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_4" -> "L_assign_1" [label="T_10.1\\ng: true\\np: 1\\nx:=0.02 + x"];
  "L_assign_5" -> "L_assign_1" [label="T_11.1\\ng: true\\np: 1\\nx:=0.03 + x"];
  "L_probabilistic_3" -> "L_assign_4" [label="T_12.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_3" -> "L_assign_5" [label="T_12.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_probabilistic_4" -> "L_probabilistic_2" [label="T_13.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_4" -> "L_probabilistic_3" [label="T_13.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_branch_1" -> "L_probabilistic_1" [label="T_14.1\\ng: 100 * y <= 49\\np: 1\\nid"];
  "L_branch_1" -> "L_probabilistic_4" [label="T_15.1\\ng: not 100 * y <= 49\\np: 1\\nid"];
  "L_while_1" -> "L_branch_1" [label="T_16.1\\ng: 100 * x <= 47\\np: 1\\nid"];
  "L_while_1" -> "l_t" [label="T_17.1\\ng: not 100 * x <= 47\\np: 1\\nid"];
  "L_assign_6" -> "L_while_1" [label="T_18.1\\ng: true\\np: 1\\nt:=0"];
  "L_assign_7" -> "L_assign_6" [label="T_19.1\\ng: true\\np: 1\\ny:=0"];
  "L_assign_8" -> "L_assign_7" [label="T_20.1\\ng: true\\np: 1\\nx:=0"];
}
