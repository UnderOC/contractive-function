  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_assert_1" -> "l_t" [label="T_1.1\\ng: alive < 0.5\\np: 1\\nid"];
  "L_assert_1" -> "l_f" [label="T_2.1\\ng: not alive < 0.5\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\ni:=0.01 + i"];
