digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_assert_1" [shape=box, label="L_assert_1\\nassert\\nI: 0 <= 100 * i and 100 * i <= 20 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: 0 <= 100 * i and 100 * i <= 20 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_skip_1" [shape=box, label="L_skip_1\\nskip\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 0.5 and (alive = 0 or alive = 1)"];
  "L_branch_1" [shape=box, label="L_branch_1\\nbranch\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_while_2" [shape=box, label="L_while_2\\nwhile\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_skip_2" [shape=box, label="L_skip_2\\nskip\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 0.5 and (alive = 0 or alive = 1)"];
  "L_branch_2" [shape=box, label="L_branch_2\\nbranch\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_while_3" [shape=box, label="L_while_3\\nwhile\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 16 and 0 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 15 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 15 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_probabilistic_2" [shape=box, label="L_probabilistic_2\\nprobabilistic\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 15 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_6" [shape=box, label="L_assign_6\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 15 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_7" [shape=box, label="L_assign_7\\nassign\\nI: 0 <= 100 * i and 100 * i <= 19 and 0 <= 100 * j and 100 * j <= 16 and 0 <= 100 * k and 100 * k <= 16 and 0.5 <= alive and alive <= 1 and (alive = 0 or alive = 1)"];
  "L_assign_8" [shape=box, label="L_assign_8\\nassign\\nI: 100 * i = 0 and 100 * j = 0 and 100 * k = 0"];
