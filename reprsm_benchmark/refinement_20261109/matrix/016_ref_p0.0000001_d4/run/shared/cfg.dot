  "L_while_3" -> "L_probabilistic_2" [label="T_16.1\\ng: 100 * k <= 15 and alive >= 0.5\\np: 1\\nid"];
  "L_while_3" -> "L_branch_2" [label="T_17.1\\ng: not (100 * k <= 15 and alive >= 0.5)\\np: 1\\nid"];
  "L_assign_6" -> "L_while_3" [label="T_18.1\\ng: true\\np: 1\\nk:=0"];
  "L_while_2" -> "L_assign_6" [label="T_19.1\\ng: 100 * j <= 15 and alive >= 0.5\\np: 1\\nid"];
  "L_while_2" -> "L_branch_1" [label="T_20.1\\ng: not (100 * j <= 15 and alive >= 0.5)\\np: 1\\nid"];
  "L_assign_7" -> "L_while_2" [label="T_21.1\\ng: true\\np: 1\\nj:=0"];
  "L_while_1" -> "L_assign_7" [label="T_22.1\\ng: 100 * i <= 19 and alive >= 0.5\\np: 1\\nid"];
  "L_while_1" -> "L_assert_1" [label="T_23.1\\ng: not (100 * i <= 19 and alive >= 0.5)\\np: 1\\nid"];
  "L_assign_8" -> "L_while_1" [label="T_24.1\\ng: true\\np: 1\\nalive:=1"];
  "L_assign_9" -> "L_assign_8" [label="T_25.1\\ng: true\\np: 1\\nk:=0"];
  "L_assign_10" -> "L_assign_9" [label="T_26.1\\ng: true\\np: 1\\nj:=0"];
  "L_assign_11" -> "L_assign_10" [label="T_27.1\\ng: true\\np: 1\\ni:=0"];
}
