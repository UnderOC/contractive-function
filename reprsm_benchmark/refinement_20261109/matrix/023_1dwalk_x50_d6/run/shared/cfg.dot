digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: -2 <= 1000 * x and 1000 * x <= 1001"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: 0 <= 1000 * x and 1000 * x <= 1000"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= 1000 * x and 1000 * x <= 1000"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= 1000 * x and 1000 * x <= 1000"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_assert_1" [shape=box, label="L_assert_1\\nassert\\nI: 0 <= 1000 * x and 1000 * x <= 1001"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_3";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_1.1\\ng: true\\np: 1\\nx:=-0.002 + x"];
  "L_assign_2" -> "L_while_1" [label="T_2.1\\ng: true\\np: 1\\nx:=0.001 + x"];
  "L_probabilistic_1" -> "L_assign_1" [label="T_3.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_1" -> "L_assign_2" [label="T_3.2\\ng: true\\np: 1 - 0.5\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_assert_1" -> "L_probabilistic_1" [label="T_4.1\\ng: 1000 * x <= 1000\\np: 1\\nid"];
  "L_assert_1" -> "l_f" [label="T_5.1\\ng: not 1000 * x <= 1000\\np: 1\\nid"];
  "L_while_1" -> "L_assert_1" [label="T_6.1\\ng: 1000 * x >= 0\\np: 1\\nid"];
  "L_while_1" -> "l_t" [label="T_7.1\\ng: not 1000 * x >= 0\\np: 1\\nid"];
  "L_assign_3" -> "L_while_1" [label="T_8.1\\ng: true\\np: 1\\nx:=0.05"];
}
