digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: -1 <= x and -1 <= y and -1 <= z"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: -1 <= x and 0 <= y and 0 <= z"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: 0.1 <= x and 0 <= y and 0 <= z"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_assign_6" [shape=box, label="L_assign_6\\nassign\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_probabilistic_2" [shape=box, label="L_probabilistic_2\\nprobabilistic\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_probabilistic_3" [shape=box, label="L_probabilistic_3\\nprobabilistic\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_assert_1" [shape=box, label="L_assert_1\\nassert\\nI: 0 <= x and 0 <= y and 0 <= z"];
  "L_assign_7" [shape=box, label="L_assign_7\\nassign\\nI: x = 300 and y = 100"];
  "L_assign_8" [shape=box, label="L_assign_8\\nassign\\nI: x = 300"];
  "L_assign_9" [shape=box, label="L_assign_9\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_9";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_1.1\\ng: true\\np: 1\\ny:=y - 1"];
  "L_assign_2" -> "L_assign_1" [label="T_2.1\\ng: true\\np: 1\\nx:=x - 1"];
  "L_assign_3" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nz:=z - 1"];
  "L_probabilistic_1" -> "L_assign_2" [label="T_4.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_1" -> "L_assign_3" [label="T_4.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_4" -> "L_while_1" [label="T_5.1\\ng: true\\np: 1\\ny:=y + 0.1"];
  "L_assign_5" -> "L_assign_4" [label="T_6.1\\ng: true\\np: 1\\nx:=x + 0.1"];
  "L_assign_6" -> "L_while_1" [label="T_7.1\\ng: true\\np: 1\\nz:=z + 0.1"];
  "L_probabilistic_2" -> "L_assign_5" [label="T_8.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_2" -> "L_assign_6" [label="T_8.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_probabilistic_3" -> "L_probabilistic_1" [label="T_9.1\\ng: true\\np: 0.9\\nid"];
  "L_probabilistic_3" -> "L_probabilistic_2" [label="T_9.2\\ng: true\\np: 1 - 0.9\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_assert_1" -> "L_probabilistic_3" [label="T_10.1\\ng: x + y + z <= 1000\\np: 1\\nid"];
  "L_assert_1" -> "l_f" [label="T_11.1\\ng: not x + y + z <= 1000\\np: 1\\nid"];
  "L_while_1" -> "L_assert_1" [label="T_12.1\\ng: x >= 0 and y >= 0 and z >= 0\\np: 1\\nid"];
  "L_while_1" -> "l_t" [label="T_13.1\\ng: not (x >= 0 and y >= 0 and z >= 0)\\np: 1\\nid"];
  "L_assign_7" -> "L_while_1" [label="T_14.1\\ng: true\\np: 1\\nz:=150"];
  "L_assign_8" -> "L_assign_7" [label="T_15.1\\ng: true\\np: 1\\ny:=100"];
  "L_assign_9" -> "L_assign_8" [label="T_16.1\\ng: true\\np: 1\\nx:=300"];
}
