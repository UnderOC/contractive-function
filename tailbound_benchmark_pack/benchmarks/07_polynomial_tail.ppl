# Polynomially decreasing iteration tail
# Source: Tail Probabilities for Randomized Program Runtimes via Martingales for Higher Moments (2019), Appendix G, PDF p.38
# URL: https://arxiv.org/pdf/1811.06779v2
# Independently normalized pseudocode; NOT a native input file for any baseline tool.
# C is a ghost counter: one increment per loop-body execution; not CFG runtime.

m := 1;
C := 0;
r ~ Uniform(0, 1);
while r * (m + 1) * (m + 1) <= m * m do
    C := C + 1;
    r ~ Uniform(0, 1);
    m := m + 1
od
