digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_refute_1" [shape=box, label="L_refute_1\\nrefute\\nI: m >= 1 and r >= 0 and r <= 1 and r * (m + 1) * (m + 1) - m * m >= 0"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: m >= 1 and r >= 0 and r <= 1"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: m >= 1 and r >= 0 and r <= 1"];
  "L_sample_1" [shape=box, label="L_sample_1\\nsample\\nI: m >= 1 and r >= 0 and r <= 1 and m * m - r * (m + 1) * (m + 1) >= 0"];
  "L_sample_2" [shape=box, label="L_sample_2\\nsample\\nI: true"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_2";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_refute_1" -> "l_t" [label="T_1.1\\ng: false\\np: 1\\nid"];
  "L_refute_1" -> "l_f" [label="T_2.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nm:=m + 1"];
  "L_sample_1" -> "L_assign_1" [label="T_4.1\\ng: true\\np: 1\\nr:=__sample_r_1; __sample_r_1~Uniform(0, 1)"];
  "L_while_1" -> "L_sample_1" [label="T_5.1\\ng: r * (m + 1) * (m + 1) <= m * m\\np: 1\\nid"];
  "L_while_1" -> "L_refute_1" [label="T_6.1\\ng: not r * (m + 1) * (m + 1) <= m * m\\np: 1\\nid"];
  "L_sample_2" -> "L_while_1" [label="T_7.1\\ng: true\\np: 1\\nr:=__sample_r_2; __sample_r_2~Uniform(0, 1)"];
  "L_assign_2" -> "L_sample_2" [label="T_8.1\\ng: true\\np: 1\\nm:=1"];
}
