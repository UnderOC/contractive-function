digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_refute_1" [shape=box, label="L_refute_1\\nrefute\\nI: x >= -1 and x <= 0"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: x >= -1"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: x >= 200"];
  "L_skip_1" [shape=box, label="L_skip_1\\nskip\\nI: x >= -1 and x <= 200"];
  "L_branch_1" [shape=box, label="L_branch_1\\nbranch\\nI: x >= -1"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: x >= 0"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_3";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_refute_1" -> "l_t" [label="T_1.1\\ng: false\\np: 1\\nid"];
  "L_refute_1" -> "l_f" [label="T_2.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nx:=x + escape_step; escape_step~Uniform(-1, 2)"];
  "L_skip_1" -> "L_while_1" [label="T_4.1\\ng: true\\np: 1\\nid"];
  "L_branch_1" -> "L_assign_1" [label="T_5.1\\ng: x >= 200\\np: 1\\nid"];
  "L_branch_1" -> "L_skip_1" [label="T_6.1\\ng: not x >= 200\\np: 1\\nid"];
  "L_assign_2" -> "L_branch_1" [label="T_7.1\\ng: true\\np: 1\\nx:=x + first_step; first_step~Uniform(-1, 0.5)"];
  "L_while_1" -> "L_assign_2" [label="T_8.1\\ng: x >= 0\\np: 1\\nid"];
  "L_while_1" -> "L_refute_1" [label="T_9.1\\ng: not x >= 0\\np: 1\\nid"];
  "L_assign_3" -> "L_while_1" [label="T_10.1\\ng: true\\np: 1\\nx:=0"];
}
