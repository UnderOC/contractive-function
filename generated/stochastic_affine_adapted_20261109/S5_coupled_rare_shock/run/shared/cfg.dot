digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_refute_1" [shape=box, label="L_refute_1\\nrefute\\nI: x * x + y * y <= 1"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: x * x + y * y <= 1"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: nx * nx + y * y <= 1"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: x * x + y * y <= 1 and z * z <= 1 and nx = 0.42 * x + 0.06 * y + 0.225 * z"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: x * x + y * y <= 1 and z * z <= 1"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: x * x + y * y <= 1"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: x * x + y * y <= 1"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: x * x + y * y <= 1"];
  "L_assign_6" [shape=box, label="L_assign_6\\nassign\\nI: x * x + y * y <= 1"];
  "L_probabilistic_2" [shape=box, label="L_probabilistic_2\\nprobabilistic\\nI: x * x + y * y <= 1"];
  "L_assign_7" [shape=box, label="L_assign_7\\nassign\\nI: true"];
  "L_assign_8" [shape=box, label="L_assign_8\\nassign\\nI: true"];
  "L_assign_9" [shape=box, label="L_assign_9\\nassign\\nI: true"];
  "L_assign_10" [shape=box, label="L_assign_10\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_10";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_refute_1" -> "l_t" [label="T_1.1\\ng: false\\np: 1\\nid"];
  "L_refute_1" -> "l_f" [label="T_2.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nx:=nx"];
  "L_assign_2" -> "L_assign_1" [label="T_4.1\\ng: true\\np: 1\\ny:=0.06 * x + 0.455 * y + 0.3 * z"];
  "L_assign_3" -> "L_assign_2" [label="T_5.1\\ng: true\\np: 1\\nnx:=0.42 * x + 0.06 * y + 0.225 * z"];
  "L_assign_4" -> "L_assign_3" [label="T_6.1\\ng: true\\np: 1\\nz:=1"];
  "L_assign_5" -> "L_assign_3" [label="T_7.1\\ng: true\\np: 1\\nz:=-1"];
  "L_probabilistic_1" -> "L_assign_4" [label="T_8.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_1" -> "L_assign_5" [label="T_8.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_6" -> "L_assign_3" [label="T_9.1\\ng: true\\np: 1\\nz:=0"];
  "L_probabilistic_2" -> "L_probabilistic_1" [label="T_10.1\\ng: true\\np: 0.01\\nid"];
  "L_probabilistic_2" -> "L_assign_6" [label="T_10.2\\ng: true\\np: 1 - 0.01\\nid"];
  "L_while_1" -> "L_probabilistic_2" [label="T_11.1\\ng: x * x + y * y > 0.5\\np: 1\\nid"];
  "L_while_1" -> "L_refute_1" [label="T_12.1\\ng: not x * x + y * y > 0.5\\np: 1\\nid"];
  "L_assign_7" -> "L_while_1" [label="T_13.1\\ng: true\\np: 1\\nnx:=0"];
  "L_assign_8" -> "L_assign_7" [label="T_14.1\\ng: true\\np: 1\\nz:=0"];
  "L_assign_9" -> "L_assign_8" [label="T_15.1\\ng: true\\np: 1\\ny:=0.86"];
  "L_assign_10" -> "L_assign_9" [label="T_16.1\\ng: true\\np: 1\\nx:=0.02"];
}
