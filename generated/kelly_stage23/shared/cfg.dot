digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_refute_1" [shape=box, label="L_refute_1\\nrefute\\nI: 0 <= wealth and round = 3"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: 0 <= wealth and 0 <= round and round <= 3"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: 0 <= wealth and 0 <= round and round <= 2"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= wealth and 0 <= round and round <= 2"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: 0 <= wealth and 0 <= round and round <= 2"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= wealth and 0 <= round and round <= 2"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: wealth = 1"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_5";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_refute_1" -> "l_t" [label="T_1.1\\ng: not wealth <= 0.6\\np: 1\\nid"];
  "L_refute_1" -> "l_f" [label="T_2.1\\ng: wealth <= 0.6\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nround:=round + 1"];
  "L_assign_2" -> "L_assign_1" [label="T_4.1\\ng: true\\np: 1\\nwealth:=wealth * 1.2"];
  "L_assign_3" -> "L_assign_1" [label="T_5.1\\ng: true\\np: 1\\nwealth:=wealth * 0.8"];
  "L_probabilistic_1" -> "L_assign_2" [label="T_6.1\\ng: true\\np: 0.6\\nid"];
  "L_probabilistic_1" -> "L_assign_3" [label="T_6.2\\ng: true\\np: 1 - 0.6\\nid"];
  "L_while_1" -> "L_probabilistic_1" [label="T_7.1\\ng: round <= 2\\np: 1\\nid"];
  "L_while_1" -> "L_refute_1" [label="T_8.1\\ng: not round <= 2\\np: 1\\nid"];
  "L_assign_4" -> "L_while_1" [label="T_9.1\\ng: true\\np: 1\\nround:=0"];
  "L_assign_5" -> "L_assign_4" [label="T_10.1\\ng: true\\np: 1\\nwealth:=1"];
}
