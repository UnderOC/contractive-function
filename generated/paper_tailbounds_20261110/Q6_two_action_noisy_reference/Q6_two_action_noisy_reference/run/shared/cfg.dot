digraph pcfg {
  rankdir=LR;
  node [shape=box, fontname="monospace"];
  "l_t" [shape=doublecircle, label="l_t\\nterminal\\nI: true"];
  "l_f" [shape=doublecircle, label="l_f\\nterminal\\nI: true"];
  "L_refute_1" [shape=box, label="L_refute_1\\nrefute\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_while_1" [shape=box, label="L_while_1\\nwhile\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_1" [shape=box, label="L_assign_1\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_2" [shape=box, label="L_assign_2\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_1" [shape=box, label="L_probabilistic_1\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_3" [shape=box, label="L_assign_3\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_4" [shape=box, label="L_assign_4\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_2" [shape=box, label="L_probabilistic_2\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_3" [shape=box, label="L_probabilistic_3\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_5" [shape=box, label="L_assign_5\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_6" [shape=box, label="L_assign_6\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_4" [shape=box, label="L_probabilistic_4\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_7" [shape=box, label="L_assign_7\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_8" [shape=box, label="L_assign_8\\nassign\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_5" [shape=box, label="L_probabilistic_5\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_probabilistic_6" [shape=box, label="L_probabilistic_6\\nprobabilistic\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_branch_1" [shape=box, label="L_branch_1\\nbranch\\nI: 0 <= q1 and q1 <= 2 and 0 <= q2 and q2 <= 2"];
  "L_assign_9" [shape=box, label="L_assign_9\\nassign\\nI: true"];
  "L_assign_10" [shape=box, label="L_assign_10\\nassign\\nI: true"];
  start [shape=point, label=""];
  start -> "L_assign_10";
  "l_t" -> "l_t" [label="T_absorb_normal.1\\ng: true\\np: 1\\nid"];
  "l_f" -> "l_f" [label="T_absorb_failure.1\\ng: true\\np: 1\\nid"];
  "L_refute_1" -> "l_t" [label="T_1.1\\ng: false\\np: 1\\nid"];
  "L_refute_1" -> "l_f" [label="T_2.1\\ng: true\\np: 1\\nid"];
  "L_assign_1" -> "L_while_1" [label="T_3.1\\ng: true\\np: 1\\nq1:=0.875 * q1 + 0.0625 * q1 + 0.0625"];
  "L_assign_2" -> "L_while_1" [label="T_4.1\\ng: true\\np: 1\\nq1:=0.875 * q1 + 0.0625 * q1 + 0.125"];
  "L_probabilistic_1" -> "L_assign_1" [label="T_5.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_1" -> "L_assign_2" [label="T_5.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_3" -> "L_while_1" [label="T_6.1\\ng: true\\np: 1\\nq2:=0.875 * q2 + 0.0625 * q1"];
  "L_assign_4" -> "L_while_1" [label="T_7.1\\ng: true\\np: 1\\nq2:=0.875 * q2 + 0.0625 * q1 + 0.0625"];
  "L_probabilistic_2" -> "L_assign_3" [label="T_8.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_2" -> "L_assign_4" [label="T_8.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_probabilistic_3" -> "L_probabilistic_1" [label="T_9.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_3" -> "L_probabilistic_2" [label="T_9.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_5" -> "L_while_1" [label="T_10.1\\ng: true\\np: 1\\nq1:=0.875 * q1 + 0.0625 * q2 + 0.0625"];
  "L_assign_6" -> "L_while_1" [label="T_11.1\\ng: true\\np: 1\\nq1:=0.875 * q1 + 0.0625 * q2 + 0.125"];
  "L_probabilistic_4" -> "L_assign_5" [label="T_12.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_4" -> "L_assign_6" [label="T_12.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_assign_7" -> "L_while_1" [label="T_13.1\\ng: true\\np: 1\\nq2:=0.875 * q2 + 0.0625 * q2"];
  "L_assign_8" -> "L_while_1" [label="T_14.1\\ng: true\\np: 1\\nq2:=0.875 * q2 + 0.0625 * q2 + 0.0625"];
  "L_probabilistic_5" -> "L_assign_7" [label="T_15.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_5" -> "L_assign_8" [label="T_15.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_probabilistic_6" -> "L_probabilistic_4" [label="T_16.1\\ng: true\\np: 0.5\\nid"];
  "L_probabilistic_6" -> "L_probabilistic_5" [label="T_16.2\\ng: true\\np: 1 - 0.5\\nid"];
  "L_branch_1" -> "L_probabilistic_3" [label="T_17.1\\ng: q1 >= q2\\np: 1\\nid"];
  "L_branch_1" -> "L_probabilistic_6" [label="T_18.1\\ng: not q1 >= q2\\np: 1\\nid"];
  "L_while_1" -> "L_branch_1" [label="T_19.1\\ng: (q1 - 1.5) * (q1 - 1.5) + (q2 - 1) * (q2 - 1) > 0.0625\\np: 1\\nid"];
  "L_while_1" -> "L_refute_1" [label="T_20.1\\ng: not (q1 - 1.5) * (q1 - 1.5) + (q2 - 1) * (q2 - 1) > 0.0625\\np: 1\\nid"];
  "L_assign_9" -> "L_while_1" [label="T_21.1\\ng: true\\np: 1\\nq2:=2"];
  "L_assign_10" -> "L_assign_9" [label="T_22.1\\ng: true\\np: 1\\nq1:=0"];
}
